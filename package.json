{
  "name": "commonloom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "npm run lint:docs && eslint --max-warnings 0 --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\" \"*.config.js\" \"*.config.ts\"",
    "lint:docs": "npm run lint:docs:markdown && npm run lint:docs:obsidian && npm run lint:docs:adr",
    "lint:docs:adr": "python scripts/lint-adr.py docs/adr --strict",
    "lint:docs:markdown": "markdownlint-cli2 --config .config/markdownlint-cli2.jsonc",
    "lint:docs:obsidian": "node scripts/lint-obsidian-docs.mjs",
    "precommit": "npm run check",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "eslint": "10.3.0",
    "globals": "17.6.0",
    "markdownlint-cli2": "0.22.1",
    "markdownlint-obsidian": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "vite": "8.0.11",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
